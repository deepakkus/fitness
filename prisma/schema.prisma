  user_id    BigInt    @db.UnsignedBigInt
  token      String    @db.VarChar(6)
  expires_at DateTime  @default(now()) @db.Timestamp(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
}

model user_survey {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  survey_type survey_type_enum @default(account_deletion)
  user_id     BigInt           @db.UnsignedBigInt
  reason      String?          @db.LongText
  comments    String?          @db.Text
  created_at  DateTime         @default(now()) @db.Timestamp(0)
  updated_at  DateTime?        @db.Timestamp(0)
  deleted_at  DateTime?        @db.Timestamp(0)
  users       users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model notifications {
  id                     BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  recipient_id           BigInt                  @db.UnsignedBigInt
  recipient_type         String                  @db.VarChar(32)
  triggerer_id           BigInt                  @db.UnsignedBigInt
  triggerer_type         String                  @db.VarChar(32)
  notification_type      String                  @db.VarChar(50)
  notification_key       String?                 @db.VarChar(255)
  metadata               String?                 @db.LongText
  media_thumbnail        String?                 @db.VarChar(255)
  action_url             String?                 @db.VarChar(2048)
  priority               Int?                    @db.TinyInt
  read_at                DateTime?               @db.Timestamp(0)
  aggregation_key        String?                 @db.VarChar(255)
  is_summary             Int?                    @db.TinyInt
  superseded_by_id       BigInt?                 @db.UnsignedBigInt
  created_at             DateTime                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?               @db.Timestamp(0)
  deleted_at             DateTime?               @db.Timestamp(0)
  notification_type_id   BigInt?                 @db.UnsignedBigInt
  ref_notification_types ref_notification_types? @relation(fields: [notification_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notifications_ibfk_1")

  @@index([triggerer_id, triggerer_type, deleted_at], map: "idx_triggerer_active")
  @@index([notification_type, notification_key, deleted_at], map: "idx_type_key_active")
  @@index([notification_type_id], map: "notifications_ibfk_1")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model account {
  id                       String    @id @db.VarChar(255)
  userId                   BigInt    @db.UnsignedBigInt
  type                     String    @db.VarChar(255)
  provider                 String    @db.VarChar(255)
  providerAccountId        String    @db.VarChar(255)
  refresh_token            String?   @db.Text
  access_token             String?   @db.Text
  expires_at               Int?
  token_type               String?   @db.VarChar(255)
  scope                    String?   @db.VarChar(255)
  id_token                 String?   @db.Text
  session_state            String?   @db.VarChar(255)
  refresh_token_expires_in Int?
  createdAt                DateTime  @default(now()) @db.DateTime(0)
  updatedAt                DateTime? @db.DateTime(0)
  users                    users     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_account_user")

  @@unique([provider, providerAccountId], map: "provider_providerAccountId_unique")
  @@index([userId], map: "userId_idx")
}

